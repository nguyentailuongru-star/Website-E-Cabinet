PORT=3000
DATA_DIR=data
COOKIE_SECURE=false
SOCKET_CONNECTIONS_PER_MINUTE=200
# Giới hạn yêu cầu API mỗi phút cho một địa chỉ IP (mặc định 600). Tăng khi đo nhiều client từ một máy.
API_REQUESTS_PER_MINUTE=600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_FULL_NAME=Quản trị viên hệ thống
