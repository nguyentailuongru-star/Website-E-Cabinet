PORT=3000
DATA_DIR=data
COOKIE_SECURE=false
# HTTPS nội bộ (tạo bằng: node scripts/create-cert.js --hosts <IP máy chủ>). Khi đặt, cookie tự bật Secure.
#TLS_CERT=certs/server.crt
#TLS_KEY=certs/server.key
# Sao lưu tự động mỗi N giờ (0 = tắt), giữ BACKUP_KEEP bản gần nhất trong BACKUP_DIR.
BACKUP_INTERVAL_HOURS=0
BACKUP_KEEP=14
BACKUP_DIR=backups
SOCKET_CONNECTIONS_PER_MINUTE=200
# Giới hạn yêu cầu API mỗi phút cho một địa chỉ IP (mặc định 600). Tăng khi đo nhiều client từ một máy.
API_REQUESTS_PER_MINUTE=600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_FULL_NAME=Quản trị viên hệ thống
